# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_PORT=5433
DB_PORT=5433

# User DB
USER_DB_NAME=user_db
USER_DB_USER=user_service_db_user
USER_DB_PASSWORD=user_service_db_pass

# Notification DB
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_service_db_user
NOTIFICATION_DB_PASSWORD=notification_service_db_pass

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_dev

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET=super_secret_jwt_key_that_is_at_least_256_bits_long_for_security_reasons
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Mailpit (Dev SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@example.com
